// -*- mode: json -*-

{
    "layer": "top",
    "position": "top",
    "margin-bottom": 0,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,

    "modules-left": ["custom/powermenu", "custom/e0b0", "hyprland/workspaces", "custom/e0b02"],
    "modules-center": ["custom/e0ba" ,"clock"],
    "modules-right": ["cava", "custom/space", "network", "custom/space", "pulseaudio", "custom/space", "battery"],

    "custom/powermenu": {
        "format": " 󰣇 ",
        "on-click": "~/.local/bin/powermenu",
        "tooltip": false
    },

    "hyprland/workspaces": {
	    "format": "{icon}",
	    "format-icons": {
	    	"1": " • ",
	    	"2": " • ",
	    	"3": " • ",
	    	"4": " • ",
	    	"5": " • ",
	    	"active": " 󰮯 ",
            "special": ""
	    },
	    "persistent-workspaces": {
	    	"*": 5,
	    	"eDP-1": 5
	    }
    },

    "clock": {
        "format-alt": "{:%a, %d. %b %H:%M}",
        "tooltip": false
    },

    "cava": {
	    "cava_config": "$XDG_CONFIG_HOME/cava/config",
	    "framerate": 30,
	    "autosens": 1,
	    "bars": 12,
	    "lower_cutoff_freq": 50,
	    "higher_cutoff_freq": 10000,
	    "method": "pulse",
	    "source": "auto",
	    "stereo": true,
	    "bar_delimiter": 0,
	    "noise_reduction": 0.77,
	    "input_delay": 2,
            "hide_on_silence": true,
	    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
	    "actions": {
	        "on-click-right": "mode"
	    }
    },

    "network": {
        "format-wifi": "  {bandwidthDownBits}",
        "format-ethernet": "󰛳 {bandwidthDownBits}",
        "format-disconected": "󰲛 No Network"
    },

    "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-icons": [
      "",
      "",
      " "
    ],
    "nospacing": 1,
    "format-muted": " ",
    "on-click": "pavucontrol",
    "tooltip": false
   },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄{capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": "󱈑 {capacity}%",
    "format-icons": [
      "󱊡",
      "󱊢",
      "󱊣"
    ]
   },

    "custom/e0b0": {
        "format": "<span size='large' rise='-1500'></span>",
        "tooltip": false
    },

    "custom/e0b02": {
        "format": "<span size='large' rise='-1500'></span>",
        "tooltip": false
    },

    "custom/e0ba": {
        "format": "<span size='large' rise='-1500'></span>",
        "tooltip": false
    },

    "custom/e0ba": {
        "format": "<span size='large' rise='-1500'></span>",
        "tooltip": false
    },

    "custom/e0b22": {
        "format": "",
        "tooltip": false
    },

    "custom/space": {
        "format": " ",
        "tooltip": false
    },

    "custom/space2": {
        "format": " ",
        "tooltip": false
    }
}
